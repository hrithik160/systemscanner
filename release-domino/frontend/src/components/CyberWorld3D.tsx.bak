  Eye,
  Target,
  Compass,
  Flame,
  Zap,
  Play,
  Pause,
  RotateCcw,
  Repeat,
  Boxes,
  GitBranch,
  Activity,
  Gauge,
  AudioWaveform,
  Wifi,
  WifiOff,
  Command,
  Sparkles,
