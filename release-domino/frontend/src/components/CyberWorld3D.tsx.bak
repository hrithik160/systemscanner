} from 'lucide-react';

/* -------------------------------------------------------------------------- */
/*                                3D CAMERA CONTROLLER                         */
/* -------------------------------------------------------------------------- */
interface CameraControlProps {
  preset: 'overview' | 'crown' | 'ingress' | 'tactical' | null;
  selectedPos: [number, number, number] | null;
  onPresetDone: () => void;
}

const CameraController: React.FC<CameraControlProps> = ({
  preset,
  selectedPos,
  onPresetDone,
}) => {
  const { camera } = useThree();
  const controlsRef = useRef<OrbitControlsType>(null);

  // Smooth camera repositioning on presets
  useEffect(() => {
    if (!preset) return;

    if (preset === 'overview') {
      camera.position.set(0, 16, 28);
      camera.lookAt(0, 0, 0);
      controlsRef.current?.target.set(0, 0, 0);
    } else if (preset === 'crown') {
      camera.position.set(14, 8, 14);
      camera.lookAt(14, 0, 4);
      controlsRef.current?.target.set(14, 0, 4);
    } else if (preset === 'ingress') {
      camera.position.set(-16, 8, 14);
      camera.lookAt(-16, 0, -2);
      controlsRef.current?.target.set(-16, 0, -2);
    } else if (preset === 'tactical') {
      camera.position.set(0, 32, 2);
      camera.lookAt(0, 0, 0);
      controlsRef.current?.target.set(0, 0, 0);
    }

    onPresetDone();
  }, [preset, camera, onPresetDone]);

  // Center target when selected node changes
  const prevTargetRef = useRef<string | null>(null);
  useEffect(() => {
    if (selectedPos) {
      const key = selectedPos.join(',');
      if (prevTargetRef.current !== key) {
        prevTargetRef.current = key;
        controlsRef.current?.target.set(...selectedPos);
      }
    }
  }, [selectedPos]);

  return (
    <OrbitControls
      ref={controlsRef}
      enableDamping={true}
      dampingFactor={0.06}
      enablePan={true}
      enableZoom={true}
      enableRotate={true}
      panSpeed={1.2}
      rotateSpeed={0.8}
      zoomSpeed={1.2}
      minDistance={3}
      maxDistance={90}
      maxPolarAngle={Math.PI / 2 + 0.12}
      screenSpacePanning={true}
    />
  );
};

/* -------------------------------------------------------------------------- */
/*                                3D NODE OBJECT                              */
/* -------------------------------------------------------------------------- */
interface Node3DProps {
  node: CNode;
  position: [number, number, number];
  isSelected: boolean;
  isShockwaveActive: boolean;
  isCurrentTarget: boolean;
  onClick: (id: string) => void;
}

const CyberNodeObject: React.FC<Node3DProps> = ({
  node,
  position,
  isSelected,
  isShockwaveActive,
  isCurrentTarget,
  onClick,
}) => {
  const groupRef = useRef<THREE.Group>(null);
  const ringRef = useRef<THREE.Mesh>(null);
  const ring2Ref = useRef<THREE.Mesh>(null);
  const [hovered, setHovered] = useState(false);

  useFrame((state) => {
    if (!groupRef.current) return;
    const t = state.clock.getElapsedTime();
    const phase = position[0] * 0.35 + position[2] * 0.25;
    groupRef.current.position.y = position[1] + Math.sin(t * 1.5 + phase) * 0.16;

    if (ringRef.current) {
      ringRef.current.rotation.z = t * 0.85;
      ringRef.current.rotation.x = t * 0.45;
    }
    if (ring2Ref.current) {
      ring2Ref.current.rotation.z = -t * 1.1;
      ring2Ref.current.rotation.y = t * 0.65;
    }
  });

  const isCrown = !!node.is_crown_jewel;
  const isChanged = node.status === 'changed';
  const isImpacted = node.status === 'impacted' || isShockwaveActive;
  const isFailing = node.status === 'failing' || (node.risk || 0) >= 70;

  // Determine hardware mesh model based on node kind / label
  const labelLower = (node.label || node.id).toLowerCase();
  const isDb = labelLower.includes('db') || labelLower.includes('data') || labelLower.includes('sql') || labelLower.includes('postgres') || labelLower.includes('redis') || node.kind === 'infra';
  const isIdentity = labelLower.includes('auth') || labelLower.includes('jwt') || labelLower.includes('token') || labelLower.includes('iam') || labelLower.includes('identity') || labelLower.includes('guard');
  const isLaptop = labelLower.includes('laptop') || labelLower.includes('client') || labelLower.includes('dev') || labelLower.includes('workstation') || labelLower.includes('ui') || node.kind === 'view';
  const isIoT = labelLower.includes('printer') || labelLower.includes('iot') || labelLower.includes('sensor');

  let mainColor = '#8b5cf6';
  let emissiveColor = '#8b5cf6';
  let emissiveIntensity = isSelected ? 1.7 : isImpacted ? 1.5 : 0.45;

  if (isCrown) {
    mainColor = isFailing || isImpacted ? '#ef4444' : '#fbbf24';
    emissiveColor = isFailing || isImpacted ? '#ef4444' : '#f59e0b';
    emissiveIntensity = isFailing || isImpacted ? 2.0 : 1.6;
  } else if (isFailing) {
    mainColor = '#ef4444';
    emissiveColor = '#ef4444';
    emissiveIntensity = 1.9;
  } else if (isImpacted) {
    mainColor = '#f43f5e';
    emissiveColor = '#f43f5e';
    emissiveIntensity = 1.6;
  } else if (isChanged) {
    mainColor = '#06b6d4';
    emissiveColor = '#06b6d4';
    emissiveIntensity = 1.5;
  } else if (node.kind === 'sandbox') {
    mainColor = '#10b981';
    emissiveColor = '#10b981';
    emissiveIntensity = 1.4;
  }

  const renderShape = () => {
    // 1. Database Unit (Cylinder with torus accent bands)
    if (isDb && !isCrown) {
      return (
        <group>
          <mesh castShadow receiveShadow>
            <cylinderGeometry args={[0.72, 0.72, 1.4, 24]} />
            <meshStandardMaterial
              color={mainColor}
              emissive={emissiveColor}
              emissiveIntensity={emissiveIntensity}
              roughness={0.2}
              metalness={0.8}
            />
          </mesh>
          <mesh position={[0, 0.38, 0]}>
            <torusGeometry args={[0.75, 0.045, 12, 24]} />
            <meshBasicMaterial color="#ffffff" />
          </mesh>
          <mesh position={[0, -0.38, 0]}>
            <torusGeometry args={[0.75, 0.045, 12, 24]} />
            <meshBasicMaterial color="#ffffff" />
          </mesh>
        </group>
      );
    }

    // 2. Identity / Security (Octahedron crystal with dual gyroscopic rotating rings)
    if (isIdentity || isCrown) {
      return (
        <group>
          <mesh castShadow receiveShadow>
            <octahedronGeometry args={[0.88, 0]} />
            <meshStandardMaterial
              color={mainColor}
              emissive={emissiveColor}
              emissiveIntensity={emissiveIntensity}
              roughness={0.15}
              metalness={0.9}
            />
          </mesh>
          <mesh ref={ringRef}>
            <torusGeometry args={[1.25, 0.035, 12, 32]} />
            <meshBasicMaterial color={emissiveColor} />
          </mesh>
          <mesh ref={ring2Ref}>
            <torusGeometry args={[1.45, 0.025, 12, 32]} />
            <meshBasicMaterial color="#ffffff" />
          </mesh>
        </group>
      );
    }

    // 3. Laptop / Workstation (Angled screen + keyboard deck base)
    if (isLaptop) {
      return (
        <group>
          <mesh position={[0, -0.35, 0]} castShadow receiveShadow>
            <boxGeometry args={[1.25, 0.16, 0.95]} />
            <meshStandardMaterial
              color="#170f2e"
              emissive={emissiveColor}
              emissiveIntensity={emissiveIntensity * 0.4}
              roughness={0.3}
              metalness={0.7}
            />
          </mesh>
          <mesh position={[0, 0.16, -0.22]} rotation={[-0.28, 0, 0]}>
            <boxGeometry args={[1.15, 0.85, 0.07]} />
            <meshStandardMaterial
              color={mainColor}
              emissive={emissiveColor}
              emissiveIntensity={emissiveIntensity}
              roughness={0.2}
              metalness={0.8}
            />
          </mesh>
        </group>
      );
    }

    // 4. IoT / Network Appliance (Cube with antenna cylinder rod & emitter tip)
    if (isIoT) {
      return (
        <group>
          <mesh castShadow receiveShadow>
            <boxGeometry args={[0.92, 0.78, 0.92]} />
            <meshStandardMaterial
              color={mainColor}
              emissive={emissiveColor}
              emissiveIntensity={emissiveIntensity}
              roughness={0.3}
              metalness={0.7}
            />
          </mesh>
          <mesh position={[0.26, 0.62, 0.26]}>
            <cylinderGeometry args={[0.03, 0.03, 0.45, 12]} />
            <meshBasicMaterial color="#94a3b8" />
          </mesh>
          <mesh position={[0.26, 0.85, 0.26]}>
            <sphereGeometry args={[0.08, 12, 12]} />
            <meshBasicMaterial color={emissiveColor} />
          </mesh>
        </group>
      );
    }

    // 5. Server Tower / Rack (Tall chassis with 3 drive bay LED slot indicators)
    return (
      <group>
        <mesh castShadow receiveShadow>
          <boxGeometry args={[0.95, 1.4, 0.95]} />
          <meshStandardMaterial
            color={mainColor}
            emissive={emissiveColor}
            emissiveIntensity={emissiveIntensity}
            roughness={0.25}
            metalness={0.75}
          />
        </mesh>
        <mesh position={[0, 0.38, 0.49]}>
          <boxGeometry args={[0.75, 0.08, 0.02]} />
          <meshBasicMaterial color="#ffffff" />
        </mesh>
        <mesh position={[0, 0.05, 0.49]}>
          <boxGeometry args={[0.75, 0.08, 0.02]} />
          <meshBasicMaterial color={isChanged ? '#06b6d4' : '#c4b5fd'} />
        </mesh>
        <mesh position={[0, -0.28, 0.49]}>
          <boxGeometry args={[0.75, 0.08, 0.02]} />
          <meshBasicMaterial color="#ffffff" />
        </mesh>
      </group>
    );
  };

  const scale = isSelected ? 1.4 : isImpacted ? 1.25 : hovered ? 1.18 : 1.0;

  return (
    <group
      ref={groupRef}
      position={position}
      scale={[scale, scale, scale]}
      onClick={(e) => {
        e.stopPropagation();
        onClick(node.id);
      }}
      onPointerOver={(e) => {
        e.stopPropagation();
        setHovered(true);
        document.body.style.cursor = 'pointer';
      }}
      onPointerOut={() => {
        setHovered(false);
        document.body.style.cursor = 'default';
      }}
    >
      {/* Crown Jewel Multi-Orbital Halos */}
      {isCrown && (
        <group>
          <mesh ref={ringRef}>
            <torusGeometry args={[1.6, 0.055, 16, 40]} />
            <meshBasicMaterial color={isFailing || isImpacted ? '#ef4444' : '#fbbf24'} />
          </mesh>
          <mesh ref={ring2Ref}>
            <torusGeometry args={[1.9, 0.035, 16, 40]} />
            <meshBasicMaterial color={isFailing || isImpacted ? '#ef4444' : '#ffffff'} />
          </mesh>
          <pointLight
            color={isFailing || isImpacted ? '#ef4444' : '#fbbf24'}
            intensity={3.5}
            distance={9}
            decay={2}
          />
        </group>
      )}

      {/* Compromised Node Pulsing Red Wireframe Sphere Shield */}
      {isImpacted && (
        <mesh>
          <sphereGeometry args={[1.65, 16, 16]} />
          <meshBasicMaterial color="#ef4444" transparent opacity={0.3} wireframe />
        </mesh>
      )}

      {/* Changed Node Pulse Ring */}
      {isChanged && !isCrown && (
        <mesh ref={ringRef}>
          <torusGeometry args={[1.4, 0.04, 12, 24]} />
          <meshBasicMaterial color="#06b6d4" />
        </mesh>
      )}

      {/* Core 3D Geometry */}
      {renderShape()}

      {/* Floating 3D Holographic Label HUD */}
      <Html position={[0, 1.4, 0]} center distanceFactor={18} className="pointer-events-none select-none">
        <div
          style={{
            padding: '4px 10px',
            borderRadius: '10px',
            fontFamily: 'monospace',
            fontSize: '11px',
            whiteSpace: 'nowrap',
            backdropFilter: 'blur(12px)',
            border: isCrown
              ? '1.5px solid #fbbf24'
              : isFailing || isImpacted
              ? '1.5px solid #ef4444'
              : isChanged
              ? '1.5px solid #06b6d4'
              : isSelected
              ? '2px solid #a855f7'
              : '1px solid rgba(139, 92, 246, 0.35)',
            backgroundColor: isCrown
              ? 'rgba(69, 26, 3, 0.92)'
              : isFailing || isImpacted
              ? 'rgba(69, 10, 10, 0.92)'
              : isChanged
              ? 'rgba(8, 47, 73, 0.92)'
              : isSelected
              ? 'rgba(30, 15, 60, 0.95)'
              : 'rgba(14, 9, 29, 0.88)',
            color: isCrown
              ? '#fde68a'
              : isFailing || isImpacted
              ? '#fca5a5'
              : isChanged
              ? '#7dd3fc'
              : isSelected
              ? '#e9d5ff'
              : '#c4b5fd',
            boxShadow: isCrown
              ? '0 0 20px rgba(251, 191, 36, 0.6)'
              : isFailing || isImpacted
              ? '0 0 20px rgba(239, 68, 68, 0.65)'
              : isChanged
              ? '0 0 16px rgba(6, 182, 212, 0.5)'
              : isSelected
              ? '0 0 18px rgba(168, 85, 247, 0.6)'
              : '0 4px 12px rgba(0,0,0,0.4)',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontWeight: 'bold' }}>
            {isCrown ? (
              <Crown style={{ width: 12, height: 12, color: '#fbbf24' }} />
            ) : isFailing || isImpacted ? (
              <ShieldAlert style={{ width: 12, height: 12, color: '#f87171' }} />
            ) : isChanged ? (
              <Zap style={{ width: 12, height: 12, color: '#38bdf8' }} />
            ) : (
              <ShieldCheck style={{ width: 12, height: 12, color: '#a855f7' }} />
            )}
            <span>{node.label || node.id.split('/').pop()}</span>
          </div>
          <div style={{ fontSize: '9px', opacity: 0.85, marginTop: '2px', display: 'flex', gap: '6px', justifyContent: 'center' }}>
            <span>{node.kind.toUpperCase()}</span>
            <span>•</span>
            <span>RISK {Math.round(node.risk || 0)}</span>
            {node.loc > 0 && (
              <>
                <span>•</span>
                <span>{node.loc} LOC</span>
              </>
            )}
          </div>
        </div>
      </Html>
    </group>
  );
};

/* -------------------------------------------------------------------------- */
/*                                3D EDGE OBJECT                              */
/* -------------------------------------------------------------------------- */
interface Edge3DProps {
  edge: CEdge;
  start: [number, number, number];
  end: [number, number, number];
  isSelected: boolean;
  isShockwaveActive: boolean;
  onClick: (id: string) => void;
}

const CyberEdgeObject: React.FC<Edge3DProps> = ({
  edge,
  start,
  end,
  isSelected,
  isShockwaveActive,
  onClick,
}) => {
  const photonRef = useRef<THREE.Mesh>(null);
  const [hovered, setHovered] = useState(false);

  const curve = useMemo(() => {
    const p1 = new THREE.Vector3(...start);
    const p2 = new THREE.Vector3(...end);
    const mid = new THREE.Vector3()
      .addVectors(p1, p2)
      .multiplyScalar(0.5);

    const dist = p1.distanceTo(p2);
    mid.y += Math.min(2.8, dist * 0.22);

    return new THREE.QuadraticBezierCurve3(p1, mid, p2);
  }, [start, end]);

  useFrame((state) => {
    if (!photonRef.current || !isShockwaveActive) return;
    const t = state.clock.getElapsedTime();
    const progress = (t * 1.8) % 1;
    const point = curve.getPoint(progress);
    photonRef.current.position.copy(point);
  });

  const tubeRadius = isSelected ? 0.09 : isShockwaveActive ? 0.08 : hovered ? 0.07 : 0.04;
  const edgeColor = isShockwaveActive ? '#ef4444' : isSelected ? '#a855f7' : hovered ? '#c084fc' : '#7c3aed';

  const tubeGeometry = useMemo(() => {
    return new THREE.TubeGeometry(curve, 28, tubeRadius, 8, false);
  }, [curve, tubeRadius]);

  const hitboxGeometry = useMemo(() => {
    return new THREE.TubeGeometry(curve, 16, 0.45, 6, false);
  }, [curve]);

  return (
    <group>
      {/* Invisible Expanded Click Hitbox */}
      <mesh
        geometry={hitboxGeometry}
        onClick={(e) => {
          e.stopPropagation();
          onClick(edge.id);
        }}
        onPointerOver={(e) => {
          e.stopPropagation();
          setHovered(true);
          document.body.style.cursor = 'pointer';
        }}
        onPointerOut={() => {
          setHovered(false);
          document.body.style.cursor = 'default';
        }}
      >
        <meshBasicMaterial transparent opacity={0} depthWrite={false} />
      </mesh>

      {/* Visible Glowing Conduit Tube */}
      <mesh geometry={tubeGeometry}>
        <meshBasicMaterial
          color={edgeColor}
          transparent
          opacity={isShockwaveActive ? 1.0 : isSelected ? 0.9 : hovered ? 0.8 : 0.45}
        />
      </mesh>

      {/* Shockwave Traveling Photon Particle */}
      {isShockwaveActive && (
        <mesh ref={photonRef}>
          <sphereGeometry args={[0.26, 14, 14]} />
          <meshBasicMaterial color="#ffffff" />
          <pointLight color="#ef4444" intensity={4} distance={4} />
        </mesh>
      )}
    </group>
  );
};

/* -------------------------------------------------------------------------- */
/*                                MAIN 3D WORLD                               */
/* -------------------------------------------------------------------------- */
export const CyberWorld3D: React.FC = () => {
  const {
    graph,
    risk,
    mode,
    setMode,
    connected,
    selectedNodeId,
    selectedEdgeId,
    selectNode,
    selectEdge,
    shockwaveStep,
    isShockwavePlaying,
    shockwaveSpeed,
    startShockwave,
    pauseShockwave,
    resetShockwave,
    setViewMode,
    setIsNodeStudioOpen,
  } = useReleaseStore();

  const [cameraPreset, setCameraPreset] = useState<'overview' | 'crown' | 'ingress' | 'tactical' | null>(null);

  // Calculate 3D coordinates for each node
  const nodePositions = useMemo(() => {
    const map = new Map<string, [number, number, number]>();

    graph.nodes.forEach((n, idx) => {
      const rawX = n.pos?.x ?? 120 + (idx % 5) * 210;
      const rawY = n.pos?.y ?? 100 + Math.floor(idx / 5) * 150;

      const x = (rawX - 550) * 0.046;
      const y = -(rawY - 320) * 0.042;

      let z = 0;
      if (n.is_crown_jewel) z = 4.5;
      else if (n.kind === 'infra') z = 3.6;
      else if (n.kind === 'service') z = 2.4;
      else if (n.kind === 'route') z = 0.5;
      else if (n.kind === 'sandbox') z = 1.8;
      else if (n.status === 'changed') z = -2.5;

      map.set(n.id, [x, y, z]);
    });

    return map;
  }, [graph.nodes]);

  const selectedPos = selectedNodeId ? nodePositions.get(selectedNodeId) ?? null : null;

  // KPIs
  const compromisedCount = graph.nodes.filter(
    (n) => n.status === 'impacted' || n.status === 'failing' || (shockwaveStep !== null && (n.depth ?? 99) <= shockwaveStep)
  ).length;
  const totalNodes = graph.nodes.length;
  const isCrownBreached = graph.nodes.some(
    (n) => n.is_crown_jewel && (n.status === 'impacted' || n.status === 'failing' || (shockwaveStep !== null && (n.depth ?? 99) <= shockwaveStep))
  );
  const timeToImpact = isCrownBreached ? 16 : compromisedCount > 0 ? 24 : null;
  const posture = isCrownBreached ? 'CRITICAL' : compromisedCount > 0 ? 'ELEVATED' : 'GUARDED';

  // Kill Chain Narrative feed
  const narrativeLogs = useMemo(() => {
    const logs: { t: number; text: string; isCrown: boolean }[] = [];
    logs.push({ t: 0, text: 'Initial breach established on entry route', isCrown: false });
    if (shockwaveStep !== null && shockwaveStep >= 1) {
      logs.push({ t: 4, text: 'SMB lateral movement & authentication probe', isCrown: false });
    }
    if (shockwaveStep !== null && shockwaveStep >= 2) {
      logs.push({ t: 9, text: 'SSH credential pivot & service token hijacking', isCrown: false });
    }
    if (shockwaveStep !== null && shockwaveStep >= 3) {
      logs.push({ t: 16, text: 'Direct impact on Crown Jewel database assets', isCrown: true });
    }
    return logs;
  }, [shockwaveStep]);

  return (
    <main className="command-shell select-none">
      <div className="ambient ambient-a" />
      <div className="ambient ambient-b" />

      {/* Left Navigation Rail (Matching Breach Domino) */}
      <aside className="side-rail">
        <div className="brand-mark">
          <Shield size={20} strokeWidth={2.4} />
          <span>RD</span>
        </div>
        <div className="rail-divider" />
        <button
          className="rail-action active"
          title="3D Cyber Warfare Space (Hotkey: V)"
          onClick={() => setViewMode('3d')}
        >
          <Boxes size={18} />
        </button>
        <button
          className="rail-action"
          title="2D Schematic Graph (Hotkey: V)"
          onClick={() => setViewMode('2d')}
        >
          <GitBranch size={18} />
        </button>
        <button className="rail-action" title="Telemetry"><Activity size={18} /></button>
        <button className="rail-action" title="Command Center"><Gauge size={18} /></button>
        <div className="rail-spacer" />
        <button
          className={`rail-action ${mode === 'whatif' ? 'active text-amber-300' : ''}`}
          title="Toggle What-If Lab (Hotkey: W)"
          onClick={() => setMode(mode === 'live' ? 'whatif' : 'live')}
        >
          <Crosshair size={18} />
        </button>
        <div className="rail-avatar">RD</div>
      </aside>

      {/* Main Workspace Area */}
      <section className="workspace">
        {/* Top Header Bar */}
        <header className="topbar">
          <div className="topbar-project">
            <div className="project-glyph"><AudioWaveform size={18} /></div>
            <div>
              <div className="eyebrow">SECURITY OPERATIONS // SIMULATOR</div>
              <div className="project-name">
                RELEASE <span>DOMINO</span>
                <span className="project-env">{mode.toUpperCase()}</span>
              </div>
            </div>
          </div>
          <div className="topbar-center">
            <span className="breadcrumb-muted">Command</span>
            <span className="crumb-slash">/</span>
            <strong>Attack Surface Topology</strong>
            <span className="live-chip">
              <i /> 3D IMMERSIVE
            </span>
          </div>
          <div className="topbar-right">
            <button
              onClick={() => setViewMode('2d')}
              className="icon-button"
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
                padding: '4px 12px',
                width: 'auto',
                background: 'rgba(139, 92, 246, 0.2)',
                border: '1px solid #8b5cf6',
                color: '#c084fc',
                borderRadius: '9px',
                fontSize: '11px',
                fontWeight: 'bold',
                cursor: 'pointer',
              }}
              title="Toggle 2D Schematic Canvas (Hotkey: V)"
            >
              <Eye size={13} />
              <span>SWITCH TO 2D</span>
            </button>
            <div className={`connection-pill ${connected ? 'online' : 'offline'}`}>
              {connected ? <Wifi size={13} /> : <WifiOff size={13} />}
              <span>{connected ? 'TELEMETRY LIVE' : 'DEMO MODE'}</span>
            </div>
            <div className="topbar-divider" />
            <button className="icon-button" title="Command shortcuts"><Command size={15} /></button>
            <div className="user-chip">RD</div>
          </div>
        </header>

        {/* Page Heading & Risk Badge */}
        <div className="page-heading">
          <div>
            <div className="heading-eyebrow">
              <Sparkles size={12} />
              <span>REAL-TIME ATTACK PATH INTELLIGENCE</span>
            </div>
            <h1>
              Infrastructure <em>Command Center</em>
            </h1>
            <p>Interactive 3D cyber simulation. Sever connections, remediate CVEs, and deflect attack chains.</p>
          </div>
          <div className="heading-meta">
            <div className="meta-label">SECURITY POSTURE</div>
            <div className={`risk-status ${posture === 'CRITICAL' ? 'critical' : posture === 'ELEVATED' ? 'elevated' : 'guarded'}`}>
              <span className="risk-pulse" />
              {posture}
            </div>
            <div className="meta-foot">
              {mode === 'whatif' ? 'Remediation sandbox active' : 'Live production telemetry'}
            </div>
          </div>
        </div>

        {/* Metric Telemetry Strip */}
        <div className="metric-strip">
          <div className="metric-card">
            <div className="metric-icon red"><Crosshair size={16} /></div>
            <div className="metric-copy">
              <span>BLAST RADIUS</span>
              <strong>{compromisedCount}<small> / {totalNodes}</small></strong>
            </div>
            <div className="metric-trend">ASSETS</div>
          </div>
          <div className="metric-card">
            <div className="metric-icon amber"><ShieldCheck size={16} /></div>
            <div className="metric-copy">
              <span>CROWN JEWEL</span>
              <strong className="metric-word" style={{ color: isCrownBreached ? '#f87171' : '#fbbf24' }}>
                {isCrownBreached ? 'EXPOSED' : 'PROTECTED'}
              </strong>
            </div>
            <div className="metric-trend">TARGET</div>
          </div>
          <div className="metric-card">
            <div className="metric-icon mint"><Activity size={16} /></div>
            <div className="metric-copy">
              <span>TIME TO IMPACT</span>
              <strong>{timeToImpact !== null ? `${timeToImpact}<small> SEC</small>` : 'BLOCKED'}</strong>
            </div>
            <div className="metric-trend">ESTIMATE</div>
          </div>
          <div className="metric-card">
            <div className="metric-icon violet"><Boxes size={16} /></div>
            <div className="metric-copy">
              <span>ACTIVE ASSETS</span>
              <strong>{totalNodes.toString().padStart(2, '0')}<small> NODES</small></strong>
            </div>
            <div className="metric-trend">IN SCOPE</div>
          </div>
        </div>

        {/* Center Graph Section */}
        <section className="graph-section">
          {/* Top Line Header with 3D/2D Mode */}
          <div className="graph-topline">
            <div className="graph-title">
              <span className="graph-live-dot" />
              <div>
                <strong>Infrastructure Topology (3D)</strong>
                <small>Connected graph • {graph.edges.length} network pathways</small>
              </div>
            </div>
            <div className="graph-legend">
              <span><i className="legend-dot compromised" /> Compromised</span>
              <span><i className="legend-dot secure" /> Secure</span>
              <span><i className="legend-dot crown" /> Crown Jewel</span>
            </div>
            <div className="graph-tools">
              <button
                onClick={() => setViewMode('2d')}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '5px',
                  padding: '3px 9px',
                  borderRadius: '7px',
                  fontSize: '11px',
                  fontWeight: 600,
                  cursor: 'pointer',
                  border: '1px solid #8b5cf6',
                  background: 'rgba(139, 92, 246, 0.2)',
                  color: '#c084fc',
                }}
              >
                <Boxes size={12} />
                <span>3D VIEW</span>
              </button>
              <span className="zoom-hint">
                LEFT DRAG ORBIT • RIGHT DRAG PAN • SCROLL ZOOM
              </span>
              <span className="graph-mode">
                <Radio size={11} /> LIVE
              </span>
            </div>
          </div>

          {/* Integrated Simulation Control Bar & Camera Presets */}
          <div className="flex items-center justify-between px-4 py-2 bg-[#0e091d]/95 border-b border-[#2d1b54] backdrop-blur-xl text-xs font-sans">
            <div className="flex items-center gap-2">
              {isShockwavePlaying ? (
                <button
                  onClick={() => pauseShockwave()}
                  className="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-[0_0_15px_rgba(251,191,36,0.5)] transition cursor-pointer"
                >
                  <Pause className="w-3.5 h-3.5 fill-slate-950" />
                  <span>PAUSE</span>
                </button>
              ) : (
                <button
                  onClick={() => startShockwave(shockwaveSpeed || 1)}
                  className="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-gradient-to-r from-red-600 via-rose-600 to-red-500 hover:from-red-500 hover:to-rose-400 text-white shadow-[0_0_20px_rgba(239,68,68,0.5)] transition group cursor-pointer"
                >
                  <Play className="w-3.5 h-3.5 fill-white group-hover:scale-110 transition-transform" />
                  <span>RUN LIVE ATTACK</span>
                </button>
              )}

              <button
                onClick={() => resetShockwave()}
                className="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-[#1b1035] hover:bg-[#28164f] border border-[#8b5cf6]/30 text-slate-300 hover:text-white transition cursor-pointer"
                title="Reset attack simulation"
              >
                <RotateCcw className="w-3.5 h-3.5 text-slate-400" />
                <span>Reset</span>
              </button>

              <button
                onClick={() => {
                  resetShockwave();
                  setTimeout(() => startShockwave(shockwaveSpeed || 1), 100);
                }}
                className="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-[#1b1035] hover:bg-[#28164f] border border-[#8b5cf6]/30 text-slate-300 hover:text-white transition cursor-pointer"
                title="Replay attack from start"
              >
                <Repeat className="w-3.5 h-3.5 text-slate-400" />
                <span>Replay</span>
              </button>

              <div className="flex items-center rounded-xl bg-[#06030c] border border-[#2d1b54] p-0.5 ml-2">
                {[1, 2, 4].map((spd) => (
                  <button
                    key={spd}
                    onClick={() => startShockwave(spd)}
                    className={`px-2 py-0.5 rounded-lg font-mono text-[11px] font-bold transition cursor-pointer ${
                      shockwaveSpeed === spd
                        ? 'bg-[#8b5cf6] text-white shadow-[0_0_10px_#8b5cf6]'
                        : 'text-slate-400 hover:text-white'
                    }`}
                  >
                    {spd}x
                  </button>
                ))}
              </div>
            </div>

            {/* Center Status Chip */}
            <div className="flex items-center gap-2">
              <span className={`px-2.5 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase border ${
                isShockwavePlaying
                  ? 'bg-red-950/60 border-red-500/70 text-red-300 animate-pulse'
                  : 'bg-[#1b1035] border-[#8b5cf6]/40 text-[#c084fc]'
              }`}>
                {isShockwavePlaying ? '⚡ SIMULATING LIVE ATTACK' : 'ARMED // STANDBY'}
              </span>
            </div>

            {/* Right: Camera Presets */}
            <div className="flex items-center gap-1 text-xs font-mono">
              <span className="px-1 text-[10px] text-slate-400 flex items-center gap-1 font-sans">
                <Compass className="w-3.5 h-3.5 text-[#a855f7]" /> CAMERA:
              </span>
              <button
                onClick={() => setCameraPreset('overview')}
                className="px-2 py-1 rounded-lg text-slate-300 hover:text-white hover:bg-[#1b1035] transition cursor-pointer"
              >
                OVERVIEW
              </button>
              <button
                onClick={() => setCameraPreset('crown')}
                className="px-2 py-1 rounded-lg text-amber-300 hover:text-amber-200 hover:bg-[#1b1035] transition flex items-center gap-1 cursor-pointer"
              >
                <Crown className="w-3 h-3 text-amber-400" /> CROWN
              </button>
              <button
                onClick={() => setCameraPreset('ingress')}
                className="px-2 py-1 rounded-lg text-sky-300 hover:text-sky-200 hover:bg-[#1b1035] transition flex items-center gap-1 cursor-pointer"
              >
                <Radio className="w-3 h-3 text-sky-400" /> INGRESS
              </button>
              <button
                onClick={() => setCameraPreset('tactical')}
                className="px-2 py-1 rounded-lg text-emerald-300 hover:text-emerald-200 hover:bg-[#1b1035] transition flex items-center gap-1 cursor-pointer"
              >
                <Eye className="w-3 h-3 text-emerald-400" /> TACTICAL
              </button>
            </div>
          </div>

          {/* 3D Viewport Stage */}
          <div
            className="graph-stage relative flex-1 min-h-0 bg-[#06030c] overflow-hidden"
            onContextMenu={(e) => e.preventDefault()}
          >
            <div className="graph-vignette" />
            <div className="graph-watermark">RELEASE DOMINO // 3D CYBER WARFARE</div>

            {/* Canvas with OrbitControls */}
            <Canvas
              camera={{ position: [0, 16, 28], fov: 45 }}
              gl={{ antialias: true, alpha: false, powerPreference: 'high-performance' }}
              onPointerMissed={() => {
                selectNode(null);
                selectEdge(null);
              }}
            >
              <color attach="background" args={['#0a0614']} />
              <fog attach="fog" args={['#0a0614', 24, 75]} />

              {/* Lighting */}
              <ambientLight color="#1e1035" intensity={1.6} />
              <directionalLight position={[15, 25, 20]} color="#c4b5fd" intensity={1.9} />
              <pointLight position={[-15, 10, -10]} color="#8b5cf6" intensity={1.8} distance={45} />
              <pointLight position={[15, 10, 10]} color="#ef4444" intensity={1.3} distance={38} />
              <pointLight position={[0, -5, 0]} color="#10b981" intensity={0.8} distance={30} />

              {/* Starfield */}
              <Stars radius={65} depth={45} count={2800} factor={4} saturation={0.6} fade speed={0.7} />

              {/* Floor Grid */}
              <Grid
                position={[0, -7.5, 0]}
                args={[85, 85]}
                cellSize={1.5}
                cellThickness={1}
                cellColor="#2d1b54"
                sectionSize={6}
                sectionThickness={1.5}
                sectionColor="#8b5cf6"
                fadeDistance={55}
                fadeStrength={1.5}
              />

              {/* 3D Network Edges */}
              {graph.edges.map((edge) => {
                const sPos = nodePositions.get(edge.source);
                const tPos = nodePositions.get(edge.target);
                if (!sPos || !tPos) return null;

                const isEdgeShockwave =
                  !!edge.active_shockwave ||
                  (shockwaveStep !== null && (edge.depth ?? 0) <= shockwaveStep);

                return (
                  <CyberEdgeObject
                    key={edge.id}
                    edge={edge}
                    start={sPos}
                    end={tPos}
                    isSelected={edge.id === selectedEdgeId}
                    isShockwaveActive={isEdgeShockwave}
                    onClick={(id) => selectEdge(id === selectedEdgeId ? null : id)}
                  />
                );
              })}

              {/* 3D Nodes */}
              {graph.nodes.map((node) => {
                const pos = nodePositions.get(node.id) || [0, 0, 0];
                const isNodeShockwave =
                  shockwaveStep !== null && (node.depth ?? 99) <= shockwaveStep;

                return (
                  <CyberNodeObject
                    key={node.id}
                    node={node}
                    position={pos}
                    isSelected={node.id === selectedNodeId}
                    isShockwaveActive={isNodeShockwave}
                    isCurrentTarget={node.id === selectedNodeId}
                    onClick={(id) => {
                      selectNode(id);
                      setIsNodeStudioOpen(true);
                    }}
                  />
                );
              })}

              {/* Smooth Camera & Navigation Controls */}
              <CameraController
                preset={cameraPreset}
                selectedPos={selectedPos}
                onPresetDone={() => setCameraPreset(null)}
              />
            </Canvas>

            {/* Floating Bottom-Left HUD: Blast Radius, Time to Crown & Kill-Chain Narrative */}
            <div className="absolute bottom-4 left-4 z-20 w-80 rounded-2xl bg-[#0e091d]/90 border border-[#8b5cf6]/40 p-3.5 backdrop-blur-xl shadow-[0_15px_45px_rgba(10,5,25,0.8)] font-sans pointer-events-auto">
              <div className="grid grid-cols-2 gap-2 mb-2.5">
                <div className="rounded-xl bg-[#06030c] border border-[#2d1b54] p-2.5">
                  <div className="flex items-center gap-1.5 text-[10px] text-slate-400">
                    <ShieldAlert className="w-3 h-3 text-red-400" /> BLAST RADIUS
                  </div>
                  <div className="mt-1 text-lg font-bold font-mono text-slate-100">
                    {compromisedCount}
                    <span className="text-xs text-slate-500 font-normal"> / {totalNodes}</span>
                  </div>
                </div>

                <div className="rounded-xl bg-[#06030c] border border-[#2d1b54] p-2.5">
                  <div className="flex items-center gap-1.5 text-[10px] text-slate-400">
                    <Clock className="w-3 h-3 text-amber-400" /> TIME TO CROWN
                  </div>
                  <div className="mt-1 text-lg font-bold font-mono">
                    {isCrownBreached ? (
                      <span className="text-red-400">16s</span>
                    ) : (
                      <span className="text-emerald-400 text-xs font-sans font-bold">PROTECTED</span>
                    )}
                  </div>
                </div>
              </div>

              {/* Narrative Feed */}
              <div className="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
                <Terminal className="w-3.5 h-3.5 text-[#a855f7]" /> Kill-Chain Narrative
              </div>
              <div className="max-h-28 overflow-y-auto space-y-1 font-mono text-[10px]">
                {narrativeLogs.map((log, idx) => (
                  <div
                    key={idx}
                    className={`p-1.5 rounded-lg border leading-tight ${
                      log.isCrown
                        ? 'bg-red-950/40 border-red-700/50 text-red-200'
                        : 'bg-[#06030c]/90 border-[#2d1b54] text-slate-300'
                    }`}
                  >
                    <span className="text-[#a855f7] font-bold mr-1.5">[+{log.t}s]</span>
                    <span>{log.text}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Footer Bar */}
          <div className="graph-footer">
            <span>
              <span className="footer-pulse" />
              3D R3F SHADER ENGINE ACTIVE
            </span>
            <span>SPACE: RUN/PAUSE • R: RESET • W: WHAT-IF • V: 3D/2D</span>
            <span className="footer-right">
              <TerminalSquare size={12} /> ATTACK SIMULATION ONLINE
            </span>
          </div>
        </section>
      </section>
    </main>
  );
};

export default CyberWorld3D;
